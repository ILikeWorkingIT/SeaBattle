# Зависимости и виртуальные окружения
node_modules/
.venv/
venv/
env/

# Сборки и кэш
dist/
build/
.next/
.cache/
__pycache__/

# Логи и временные файлы
*.log
*.tmp
*.temp

# Секретные данные и ключи (важно для безопасности!)
