# Copy to `.env` in the repo root. Do not commit `.env`.
#
# REDIS_DATA_DIR — host folder for Redis files (Compose bind mount → /data).
# Recommended (and Compose default if this variable is unset): F:/Docker/Redis
# Any other writable path is fine, for example:
#   REDIS_DATA_DIR=D:/docker/redis
#   REDIS_DATA_DIR=./data/redis
# Uncomment and edit if you have no F: drive:
# REDIS_DATA_DIR=./data/redis
#
# REDIS_URL / HOST / PORT — for a local (non-Compose) Uvicorn process.
# Compose sets REDIS_URL=redis://redis:6379/0 inside the Docker network.

REDIS_URL=redis://localhost:6379/0
HOST=0.0.0.0
PORT=8000
